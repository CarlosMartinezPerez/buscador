# Chave da API do Gemini (Grátis no Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Configurações do Servidor de E-mail (Exemplo com Gmail ou Resend)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app_do_gmail
NOTIFY_EMAIL=seu_email_para_receber_os_editais@gmail.com

# Caminho do banco de dados (opcional)
DB_PATH=editais.db
